{
  "name": "marjane-deals-watcher",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @mdw/web --filter @mdw/worker build",
    "dev": "pnpm --parallel --filter @mdw/web --filter @mdw/worker dev",
    "db:local": "node scripts/local-db.mjs",
    "start:local": "node scripts/start-local.mjs",
    "start:prod": "node scripts/start-local.mjs --prod",
    "reboot": "node scripts/restart.mjs",
    "reboot:prod": "node scripts/restart.mjs --prod",
    "setup:browser": "pnpm --filter @mdw/worker exec playwright install chromium",
    "dev:web": "pnpm --filter @mdw/web dev",
    "dev:worker": "pnpm --filter @mdw/worker dev",
    "dev:bot": "pnpm --filter @mdw/worker dev:bot",
    "catalog": "tsx scripts/update-category-catalog.mjs",
    "db:generate": "pnpm --filter @mdw/database generate",
    "db:migrate": "pnpm --filter @mdw/worker exec tsx src/cli.ts migrate",
    "admin:create": "pnpm --filter @mdw/worker exec tsx src/cli.ts create-admin",
    "scrape:now": "pnpm --filter @mdw/worker exec tsx src/cli.ts run-now",
    "reevaluate": "pnpm --filter @mdw/worker exec tsx src/cli.ts reevaluate",
    "probe": "pnpm --filter @mdw/worker exec tsx src/cli.ts probe",
    "categories:update": "node --experimental-strip-types scripts/update-category-catalog.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@mdw/database": "workspace:*",
    "@mdw/shared": "workspace:*",
    "@types/node": "^22.15.0",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "16.14.0-beta.17",
    "playwright": "1.56.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
