# Copy to .env on the VPS:  cp .env.example .env && nano .env
# Never commit .env (it is git-ignored).

# --- Domain & HTTPS (Caddy obtains the Let's Encrypt certificate) ---
DOMAIN=deals.example.ma
ACME_EMAIL=vous@example.ma

# --- PostgreSQL ---
POSTGRES_USER=mdw
POSTGRES_DB=mdw
# Generate with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=change-me

# --- First administrator (created by the "migrate" service if no account exists) ---
ADMIN_EMAIL=vous@example.ma
# 10 characters minimum. You can remove it from .env after the first start.
ADMIN_PASSWORD=change-me-too

# --- Telegram (see docs/TELEGRAM.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduler (Africa/Casablanca local times, comma separated) ---
SCRAPE_TIMES=09:00,18:00

# --- Scraper ---
# auto: HTTP first, headless Chromium only for client-rendered listings
# never (défaut) : une seule requête simple par page, sans navigateur intégré.
# auto : navigateur intégré en dernier recours pour les pages sans données (lent, souvent refusé par le site).
RENDER_MODE=auto
# Leave empty for the default identifying user agent.
SCRAPER_USER_AGENT=

# --- Backups (number of daily dumps / weekly dumps kept) ---
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

LOG_LEVEL=info
# Only set to false for local HTTP testing without TLS.
COOKIE_SECURE=true

# Lanceur local uniquement (pnpm start:local / start:prod) : pas d'écran de
# connexion pour http://localhost. Mettre false pour garder la connexion.
# Jamais pris en compte pour une adresse autre que localhost.
# AUTH_DISABLED=true
